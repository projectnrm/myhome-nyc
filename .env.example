# NYC Open Data / Socrata app token — register at https://data.cityofnewyork.us/profile/app_tokens
# Unauthenticated calls throttle hard; get this before running ingestion (CLAUDE.md Section 10).
SOCRATA_APP_TOKEN=

# NYC Geoclient API (DoITT) — register at https://api-portal.nyc.gov and subscribe
# to the "Geoclient API" product specifically (an account alone doesn't grant access).
# Copy the Primary key from your profile page. Used only for self-lookup address ->
# BBL resolution (CLAUDE.md Section 11). Auth is a single subscription key sent via
# the Ocp-Apim-Subscription-Key header — Secondary key is stored but unused/fallback.
GEOCLIENT_PRIMARY_KEY=
GEOCLIENT_SECONDARY_KEY=
